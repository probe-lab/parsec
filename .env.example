# Every environment variable parsec reads. Values are the defaults; empty means unset.
# Copy to .env for local runs. Never put real credentials here.

# Global (all commands)
PARSEC_DEBUG=false
PARSEC_LOG_LEVEL=4
PARSEC_TELEMETRY_HOST=localhost
PARSEC_TELEMETRY_PORT=6666
PARSEC_SCHEDULE_DRY_RUN=false
PARSEC_DATABASE_HOST=localhost
PARSEC_DATABASE_PORT=5432
PARSEC_DATABASE_NAME=parsec
PARSEC_DATABASE_USER=parsec
# Set the password for your database
PARSEC_DATABASE_PASSWORD=
PARSEC_DATABASE_SSL_MODE=disable

# AWS ECS (set by ECS at runtime)
ECS_CONTAINER_METADATA_URI_V4=
ECS_CONTAINER_METADATA=
AWS_REGION=

# Scheduler
PARSEC_SCHEDULER_FLEETS=
PARSEC_SCHEDULER_INTERVAL=1m
PARSEC_SCHEDULER_PROBES=1

# Server (all server subcommands)
PARSEC_SERVER_SERVER_HOST=localhost
PARSEC_SERVER_SERVER_PORT=7070
PARSEC_SERVER_PEER_HOST=127.0.0.1
PARSEC_SERVER_PEER_PORT=4001
PARSEC_SERVER_FLEET=
PARSEC_SERVER_LEVELDB=./leveldb
PARSEC_SERVER_STARTUP_DELAY=1m
PARSEC_SERVER_FIREHOSE_REGION=us-east-1
PARSEC_SERVER_FIREHOSE_STREAM=
PARSEC_SERVER_FIREHOSE_BATCH_TIME=30s
PARSEC_SERVER_FIREHOSE_BATCH_SIZE=500
PARSEC_SERVER_FIREHOSE_CONNECTION_EVENTS=true
PARSEC_SERVER_FIREHOSE_RPC_EVENTS=true

# Server dht
PARSEC_SERVER_DHT_PROJECT=ipfs
PARSEC_SERVER_DHT_NETWORK=amino
PARSEC_SERVER_DHT_FULLRT=false
PARSEC_SERVER_DHT_OPTPROV=false
PARSEC_SERVER_DHT_SERVER_MODE=false
PARSEC_SERVER_DHT_ALPHA=10
PARSEC_SERVER_DHT_BADBITS=
PARSEC_SERVER_DHT_DENIED_CIDS=

# Server ipni
PARSEC_SERVER_IPNI_INDEXER_HOST=
PARSEC_SERVER_IPNI_INDEXER_INDEX_TIMEOUT=1m
PARSEC_SERVER_IPNI_INDEXER_AVAILABILITY_TIMEOUT=2m
PARSEC_SERVER_IPNI_INDEXER_INTERVAL=1s
PARSEC_SERVER_IPNI_PUBLISHER_HOST=127.0.0.1
PARSEC_SERVER_IPNI_PUBLISHER_PORT=2020
